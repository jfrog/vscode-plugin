{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/modules/copilot-session-start.mjs\" package-resolution",
            "timeout": 15,
            "statusMessage": "Routing package installs through JFrog Artifactory…"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/vscode-align-mcp-json.mjs\" session-start",
            "timeout": 60,
            "statusMessage": "Securing plugin MCP servers with JFrog Agent Guard…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/enforce-skill.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking this skill against your JFrog governance policy…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/enforce-skill.mjs\" --prefer-offline",
            "timeout": 30,
            "statusMessage": "Checking this skill against your JFrog governance policy…"
          }
        ]
      }
    ]
  }
}
